{
  "manifest_version": 3,
  "name": "Tholafind",
  "version": "0.1.0",
  "description": "Right-click or crop any image and start a Tholafind hunt without leaving the page.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Tholafind",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.tholafind.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.tholafind.com/extension/connect*"
      ],
      "js": [
        "connect-relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "snip": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Crop an area and hunt on Tholafind"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}